<% layout("/layouts/boilerplate") %>

<div class="payment-page container">

  <div class="payment-card">

    <div class="payment-icon">
      <i class="fa-solid fa-lock"></i>
    </div>

    <div class="payment-header">
      <h3>Complete Payment</h3>
      <p>Review your booking details before completing payment.</p>
    </div>

    <div class="payment-listing-box">

      <% if(booking.listing && booking.listing.image && booking.listing.image.url){ %>
        <img src="<%= booking.listing.image.url %>" alt="<%= booking.listing.title %>">
      <% } %>

      <div>
        <h5>
          <%= booking.listing ? booking.listing.title : "Listing not available" %>
        </h5>

        <p class="text-muted mb-0">
          <i class="fa-solid fa-location-dot me-1"></i>
          <%= booking.listing && booking.listing.location ? booking.listing.location : "Location not available" %>
        </p>
      </div>

    </div>

    <div class="payment-summary">

      <div class="payment-row">
        <span>Price per night</span>
        <strong>
          ₹<%= booking.listing && booking.listing.price
            ? booking.listing.price.toLocaleString("en-IN")
            : "0" %>
        </strong>
      </div>

      <% if(booking.checkIn && booking.checkOut){ %>
        <div class="payment-row">
          <span>Dates</span>
          <strong>
            <%= booking.checkIn.toDateString() %>
            →
            <%= booking.checkOut.toDateString() %>
          </strong>
        </div>
      <% } %>

      <div class="payment-row">
        <span>Total nights</span>
        <strong>
          <%= booking.totalNights || 1 %>
          night<%= (booking.totalNights || 1) > 1 ? "s" : "" %>
        </strong>
      </div>

      <div class="payment-row total">
        <span>Total payable</span>
        <strong>
          ₹<%= booking.totalPrice
            ? booking.totalPrice.toLocaleString("en-IN")
            : booking.listing && booking.listing.price
            ? booking.listing.price.toLocaleString("en-IN")
            : "0" %>
        </strong>
      </div>

    </div>

    <form action="/payment/<%= booking._id %>" method="POST">
      <button class="btn payment-btn">
        <i class="fa-solid fa-credit-card me-1"></i>
        Pay Now
      </button>
    </form>

    <p class="secure-payment-text">
      <i class="fa-solid fa-shield-halved"></i>
      Secure Dummy Payment Gateway
    </p>

  </div>

</div>