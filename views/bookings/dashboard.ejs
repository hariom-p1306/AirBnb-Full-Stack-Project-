<% layout('/layouts/boilerplate') -%>

    <div class="booking-page container">

        <!-- PAGE HEADER -->
        <div class="booking-page-header">
            <div>
                <p class="form-kicker">Host panel</p>

                <h2>
                    Booking Requests
                    <span>(<%= bookings.length %>)</span>
                </h2>

                <p class="text-muted mb-0">
                    Manage guest booking requests and track your hosting performance.
                </p>
            </div>
        </div>

        <!-- HOST STATS -->
        <div class="host-stats-grid">

            <div class="host-stat-card">
                <div class="stat-icon">
                    <i class="fa-solid fa-house"></i>
                </div>

                <div>
                    <p>Total Listings</p>
                    <h3>
                        <%= stats.totalListings %>
                    </h3>
                </div>
            </div>

            <div class="host-stat-card">
                <div class="stat-icon">
                    <i class="fa-regular fa-calendar"></i>
                </div>

                <div>
                    <p>Total Requests</p>
                    <h3>
                        <%= stats.totalRequests %>
                    </h3>
                </div>
            </div>

            <div class="host-stat-card">
                <div class="stat-icon pending-icon">
                    <i class="fa-solid fa-hourglass-half"></i>
                </div>

                <div>
                    <p>Pending</p>
                    <h3>
                        <%= stats.pendingRequests %>
                    </h3>
                </div>
            </div>

            <div class="host-stat-card">
                <div class="stat-icon accepted-icon">
                    <i class="fa-solid fa-check"></i>
                </div>

                <div>
                    <p>Accepted</p>
                    <h3>
                        <%= stats.acceptedBookings %>
                    </h3>
                </div>
            </div>

            <div class="host-stat-card">
                <div class="stat-icon rejected-icon">
                    <i class="fa-solid fa-xmark"></i>
                </div>

                <div>
                    <p>Rejected</p>
                    <h3>
                        <%= stats.rejectedBookings %>
                    </h3>
                </div>
            </div>

            <div class="host-stat-card revenue-card">
                <div class="stat-icon revenue-icon">
                    <i class="fa-solid fa-indian-rupee-sign"></i>
                </div>

                <div>
                    <p>Estimated Revenue</p>
                    <h3>₹<%= stats.estimatedRevenue.toLocaleString("en-IN") %>
                    </h3>
                </div>
            </div>

        </div>

        <div class="dashboard-filter-tabs">

  <a
    href="/bookings/host/dashboard"
    class="dashboard-filter-tab <%= status === 'all' ? 'active' : '' %>"
  >
    All
  </a>

  <a
    href="/bookings/host/dashboard?status=pending"
    class="dashboard-filter-tab <%= status === 'pending' ? 'active' : '' %>"
  >
    Pending
  </a>

  <a
    href="/bookings/host/dashboard?status=accepted"
    class="dashboard-filter-tab <%= status === 'accepted' ? 'active' : '' %>"
  >
    Accepted
  </a>

  <a
    href="/bookings/host/dashboard?status=rejected"
    class="dashboard-filter-tab <%= status === 'rejected' ? 'active' : '' %>"
  >
    Rejected
  </a>

  <a
    href="/bookings/host/dashboard?status=paid"
    class="dashboard-filter-tab <%= status === 'paid' ? 'active' : '' %>"
  >
    Paid
  </a>

</div>

        <!-- EMPTY STATE -->
        <% if(bookings.length===0){ %>
            <div class="empty-booking-state">
                <div class="empty-icon">
                    <i class="fa-regular fa-calendar-xmark"></i>
                </div>

                <h4>No booking requests yet</h4>

                <p class="text-muted mb-0">
                    When guests request to book your property, they will appear here.
                </p>
            </div>
            <% } %>

                <!-- BOOKING LIST -->
                <div class="booking-list">

                    <% bookings.forEach(b=> { %>

                        <div class="booking-item-card">

                            <div class="booking-img-wrap">
                                <% if(b.listing && b.listing.image && b.listing.image.url){ %>
                                    <img src="<%= b.listing.image.url %>" alt="<%= b.listing.title %>">
                                    <% } else { %>
                                        <div class="booking-placeholder-img">
                                            <i class="fa-regular fa-image"></i>
                                        </div>
                                        <% } %>
                            </div>

                            <div class="booking-content">

                                <div class="booking-main-info">
                                    <h5>
                                        <%= b.listing ? b.listing.title : "Listing not available" %>
                                    </h5>

                                    <p class="text-muted mb-1">
                                        <i class="fa-solid fa-user me-1"></i>
                                        Guest:
                                        <strong>
                                            <%= b.guest ? b.guest.username : "Unknown guest" %>
                                        </strong>
                                    </p>

                                    <p class="booking-date mb-2">
                                        <i class="fa-regular fa-calendar me-1"></i>

                                        <% if(b.checkIn && b.checkOut){ %>
                                            <%= b.checkIn.toDateString() %>
                                                <span>→</span>
                                                <%= b.checkOut.toDateString() %>
                                                    <% } else { %>
                                                        Dates not specified
                                                        <% } %>
                                    </p>

                                    <span class="booking-status 
              <%= b.status === 'accepted'
                ? 'status-accepted'
                : b.status === 'rejected'
                ? 'status-rejected'
                : 'status-pending' %>">
                                        <%= b.status %>
                                    </span>
                                </div>

                                <% if(b.status==="pending" ){ %>
                                    <div class="booking-actions">
                                        <form action="/bookings/<%= b._id %>/accept" method="POST">
                                            <button class="btn btn-success btn-sm">
                                                <i class="fa-solid fa-check me-1"></i>
                                                Accept
                                            </button>
                                        </form>

                                        <form action="/bookings/<%= b._id %>/reject" method="POST">
                                            <button class="btn btn-outline-danger btn-sm">
                                                <i class="fa-solid fa-xmark me-1"></i>
                                                Reject
                                            </button>
                                        </form>
                                    </div>
                                    <% } %>

                            </div>

                        </div>

                        <% }) %>

                </div>

    </div>