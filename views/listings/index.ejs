<% layout('/layouts/boilerplate') -%>

    <!-- ================= FILTERS ================= -->

    <div id="filters">
        <div class="filters-left">

            <div class="filter <%= category === 'Trending' ? 'active' : '' %>">
                <a href="/listings?category=Trending">
                    <i class="fa-solid fa-fire"></i>
                    <p>Trending</p>
                </a>
            </div>

            <div class="filter <%= category === 'Rooms' ? 'active' : '' %>">
                <a href="/listings?category=Rooms">
                    <i class="fa-solid fa-bed"></i>
                    <p>Rooms</p>
                </a>
            </div>

            <div class="filter <%= category === 'Iconic Cities' ? 'active' : '' %>">
                <a href="/listings?category=Iconic%20Cities">
                    <i class="fa-solid fa-mountain-city"></i>
                    <p>Iconic Cities</p>
                </a>
            </div>

            <div class="filter <%= category === 'Mountain' ? 'active' : '' %>">
                <a href="/listings?category=Mountain">
                    <i class="fa-solid fa-mountain"></i>
                    <p>Mountain</p>
                </a>
            </div>

            <div class="filter <%= category === 'Amazing Pools' ? 'active' : '' %>">
                <a href="/listings?category=Amazing%20Pools">
                    <i class="fa-solid fa-person-swimming"></i>
                    <p>Amazing Pools</p>
                </a>
            </div>

            <div class="filter <%= category === 'Camping' ? 'active' : '' %>">
                <a href="/listings?category=Camping">
                    <i class="fa-solid fa-campground"></i>
                    <p>Camping</p>
                </a>
            </div>

            <div class="filter <%= category === 'Farms' ? 'active' : '' %>">
                <a href="/listings?category=Farms">
                    <i class="fa-solid fa-cow"></i>
                    <p>Farms</p>
                </a>
            </div>

            <div class="filter <%= category === 'Boats' ? 'active' : '' %>">
                <a href="/listings?category=Boats">
                    <i class="fa-solid fa-sailboat"></i>
                    <p>Boats</p>
                </a>
            </div>

            <div class="filter <%= category === 'All' ? 'active' : '' %>">
                <a href="/listings">
                    <i class="fa-solid fa-border-all"></i>
                    <p>All</p>
                </a>
            </div>

        </div>

        <div class="advanced-filter">
            <form action="/listings" method="GET" class="advanced-filter-form">

                <% if(category){ %>
                    <input type="hidden" name="category" value="<%= category %>">
                    <% } %>

                        <input type="number" name="minPrice" class="filter-input" placeholder="Min ₹"
                            value="<%= typeof minPrice !== 'undefined' ? minPrice : '' %>" min="0">

                        <input type="number" name="maxPrice" class="filter-input" placeholder="Max ₹"
                            value="<%= typeof maxPrice !== 'undefined' ? maxPrice : '' %>" min="0">

                        <select name="sort" class="filter-select">
                            <option value="" <%=!sort ? "selected" : "" %>>Sort</option>
                            <option value="price_asc" <%=sort==="price_asc" ? "selected" : "" %>>
                                Price: Low to High
                            </option>
                            <option value="price_desc" <%=sort==="price_desc" ? "selected" : "" %>>
                                Price: High to Low
                            </option>
                        </select>

                        <% if(q){ %>
                            <input type="hidden" name="q" value="<%= q %>">
                            <% } %>

                                <button class="filter-btn" type="submit">
                                    Apply
                                </button>

                                <a href="/listings" class="clear-filter-btn">
                                    Clear
                                </a>

            </form>
        </div>

        <div class="tax-toggle">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="taxSwitch">
                <label class="form-check-label" for="taxSwitch">
                    Display total after taxes
                </label>
            </div>
        </div>
    </div>

    <!-- ================= LISTINGS ================= -->

    <div class="row g-4 mt-2">
        <% for(let listing of allListings) { %>

            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <div class="listing-card card">

                    <div class="card-img-container">
                        <a href="/listings/<%= listing._id %>" class="listing_link">
                            <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>">
                        </a>

                        <button class="wishlist-icon" type="button" data-id="<%= listing._id %>">
                            <i class="fa-regular fa-heart"></i>
                        </button>

                        <div class="rating-badge">
                            <i class="fa-solid fa-star"></i>
                            <%= listing.avgRating || "New" %>
                        </div>
                    </div>

                    <a href="/listings/<%= listing._id %>" class="listing_link">
                        <div class="card-body">
                            <div class="d-flex justify-content-between gap-2">
                                <p class="card-title mb-1">
                                    <%= listing.title %>
                                </p>
                            </div>

                            <p class="text-muted small mb-1">
                                <i class="fa-solid fa-location-dot"></i>
                                <%= listing.location %>
                            </p>

                            <p class="mb-0">
                                <span class="old-price price" data-price="<%= listing.price %>">
                                    &#8377;<%= listing.price.toLocaleString("en-IN") %>
                                </span>

                                <span class="new-price"></span>

                                <span class="text-muted">
                                    / night
                                </span>
                            </p>
                        </div>
                    </a>

                </div>
            </div>

            <% } %>
    </div>

    <script>
        document.querySelectorAll(".wishlist-icon").forEach(icon => {
            icon.addEventListener("click", async function (e) {
                e.preventDefault();
                e.stopPropagation();

                const listingId = this.dataset.id;
                const heart = this.querySelector("i");

                try {
                    const res = await fetch(`/wishlist/${listingId}`, {
                        method: "POST"
                    });

                    const data = await res.json();

                    if (data.success) {
                        if (data.saved) {
                            heart.classList.remove("fa-regular");
                            heart.classList.add("fa-solid");
                            this.classList.add("active");
                        } else {
                            heart.classList.remove("fa-solid");
                            heart.classList.add("fa-regular");
                            this.classList.remove("active");
                        }
                    } else {
                        alert(data.error || "Please login first");
                    }
                } catch (err) {
                    console.log(err);
                    alert("Something went wrong");
                }
            });
        });
        const taxSwitch = document.getElementById("taxSwitch");
        const prices = document.getElementsByClassName("price");
        const newPrices = document.getElementsByClassName("new-price");

        if (taxSwitch) {
            taxSwitch.addEventListener("change", () => {
                for (let i = 0; i < prices.length; i++) {
                    const basePrice = Number(prices[i].dataset.price);

                    if (taxSwitch.checked) {
                        const totalPrice = Math.round(basePrice * 1.18);

                        prices[i].classList.add("cut");

                        newPrices[i].innerHTML =
                            `&#8377;${totalPrice.toLocaleString("en-IN")} <small>(incl. GST)</small>`;
                    } else {
                        prices[i].classList.remove("cut");
                        newPrices[i].innerHTML = "";
                    }
                }
            });
        }
    </script>