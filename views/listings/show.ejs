<% layout('/layouts/boilerplate') -%>

  <div class="show-page container-fluid px-4 px-md-5 mt-4">

    <!-- ================= TITLE SECTION ================= -->
    <div class="listing-header mb-3">
      <h2 class="listing-show-title">
        <%= listing.title %>
      </h2>

      <div class="listing-meta">
        <span>
          <i class="fa-solid fa-star text-warning"></i>
          <%= listing.avgRating || "New" %>
        </span>

        <span>
          <i class="fa-solid fa-location-dot"></i>
          <%= listing.location %>, <%= listing.country %>
        </span>
      </div>
    </div>

    <!-- ================= IMAGE GALLERY ================= -->
    <div class="show-gallery mb-5">
      <div class="show-main-img">
        <img src="<%= listing.image.url %>" alt="<%= listing.title %>">
      </div>

      <div class="show-side-imgs">
        <img src="<%= listing.image.url %>" alt="<%= listing.title %>">
        <img src="<%= listing.image.url %>" alt="<%= listing.title %>">
        <img src="<%= listing.image.url %>" alt="<%= listing.title %>">
      </div>
    </div>

    <div class="row g-5">

      <!-- ================= LEFT CONTENT ================= -->
      <div class="col-lg-7">

        <!-- HOST INFO -->
        <section class="show-section">
          <div class="host-box">
            <div>
              <h5 class="mb-1">
                Hosted by <b>
                  <%= listing.owner.username %>
                </b>
              </h5>

              <p class="text-muted mb-0">
                Enjoy a comfortable stay with a verified host.
              </p>
            </div>

            <div class="host-avatar">
              <i class="fa-solid fa-user"></i>
            </div>
          </div>
        </section>

        <hr>

        <!-- DESCRIPTION -->
        <section class="show-section">
          <h4 class="section-title">About this place</h4>

          <p class="listing-description">
            <%= listing.description %>
          </p>
        </section>

        <hr>

        <!-- OWNER ACTIONS -->
        <% if(currUser && listing.owner._id.equals(currUser._id)){ %>
          <section class="show-section">
            <div class="owner-actions">
              <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark px-4">
                <i class="fa-solid fa-pen-to-square me-1"></i>
                Edit Listing
              </a>

              <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                <button class="btn btn-outline-danger px-4">
                  <i class="fa-solid fa-trash me-1"></i>
                  Delete
                </button>
              </form>
            </div>
          </section>

          <hr>
          <% } %>

            <!-- REVIEWS FORM -->
            <section class="show-section">
              <h4 class="section-title">Leave a Review</h4>

              <% if(currUser){ %>
                <form action="/listings/<%= listing._id %>/reviews" method="POST" class="review-form-card" novalidate>
                  <label class="form-label fw-semibold">Rating</label>

                  <fieldset class="starability-basic">
                    <input type="radio" id="star1" name="review[rating]" value="1" required>
                    <label for="star1">1 star</label>

                    <input type="radio" id="star2" name="review[rating]" value="2">
                    <label for="star2">2 stars</label>

                    <input type="radio" id="star3" name="review[rating]" value="3">
                    <label for="star3">3 stars</label>

                    <input type="radio" id="star4" name="review[rating]" value="4">
                    <label for="star4">4 stars</label>

                    <input type="radio" id="star5" name="review[rating]" value="5">
                    <label for="star5">5 stars</label>
                  </fieldset>

                  <label class="form-label fw-semibold mt-3">Comment</label>

                  <textarea name="review[comment]" class="form-control review-textarea" rows="4"
                    placeholder="Share your experience..." required></textarea>

                  <button class="btn btn-dark mt-3 px-4">
                    Submit Review
                  </button>
                </form>
                <% } else { %>
                  <div class="login-review-box">
                    <p class="mb-2">Please log in to leave a review.</p>
                    <a href="/login" class="btn btn-outline-dark btn-sm">Log in</a>
                  </div>
                  <% } %>
            </section>

            <!-- ALL REVIEWS -->
            <section class="show-section mt-4">
              <h4 class="section-title">
                Reviews
                <span class="text-muted fs-6">
                  (<%= listing.reviews.length %>)
                </span>
              </h4>

              <% if(listing.reviews.length===0){ %>
                <div class="empty-review-box">
                  <p class="mb-0">No reviews yet. Be the first to review this place.</p>
                </div>
                <% } %>

                  <div class="row g-3 mt-1">
                    <% for(review of listing.reviews){ %>
                      <div class="col-md-6">
                        <div class="review-card">
                          <div class="review-user">
                            <div class="review-avatar">
                              <i class="fa-solid fa-user"></i>
                            </div>

                            <div>
                              <% if(verifiedGuests && verifiedGuests.includes(review.author._id.toString())){ %>
                                <span class="verified-review-badge">
                                  <i class="fa-solid fa-circle-check"></i>
                                  Verified Guest
                                </span>
                                <% } %>

                                  <p class="starability-result mb-0" data-rating="<%= review.rating %>"></p>
                            </div>
                          </div>

                          <p class="review-comment">
                            <%= review.comment %>
                          </p>

                          <% if(currUser && review.author._id.equals(currUser._id)){ %>
                            <form method="POST"
                              action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                              <button class="btn btn-sm btn-outline-danger mt-2">
                                Delete
                              </button>
                            </form>
                            <% } %>
                        </div>
                      </div>
                      <% } %>
                  </div>
            </section>

      </div>

      <!-- ================= RIGHT BOOKING CARD ================= -->
      <div class="col-lg-5">
        <div class="booking-card">

          <div class="booking-price">
            <h4>
              ₹<%= listing.price.toLocaleString("en-IN") %>
                <span>/ night</span>
            </h4>

            <p class="text-muted mb-0">
              <i class="fa-solid fa-star text-warning"></i>
              <%= listing.avgRating || "New" %>
            </p>
          </div>

          <div class="unavailable-box">
            <h6>
              <i class="fa-regular fa-calendar-xmark me-1"></i>
              Unavailable Dates
            </h6>

            <% if(unavailableBookings && unavailableBookings.length> 0){ %>
              <ul>
                <% unavailableBookings.forEach(b=> { %>
                  <li>
                    <%= b.checkIn.toDateString() %>
                      <span>→</span>
                      <%= b.checkOut.toDateString() %>
                  </li>
                  <% }) %>
              </ul>
              <% } else { %>
                <p class="text-muted mb-0">
                  No confirmed bookings yet. All dates are currently available.
                </p>
                <% } %>
          </div>

          <form id="bookingForm" data-listing-id="<%= listing._id %>">

            <div class="booking-input-grid">
              <div>
                <label class="form-label">Check-in</label>
                <input type="date" name="checkIn" class="form-control" required>
              </div>

              <div>
                <label class="form-label">Check-out</label>
                <input type="date" name="checkOut" class="form-control" required>
              </div>
            </div>

            <button class="btn btn-danger w-100 mt-3 py-2 booking-btn" type="submit">
              Book Now
            </button>

            <p class="text-muted text-center mt-3 mb-0">
              You won't be charged yet
            </p>
          </form>

          <div id="paymentSection" style="display:none;" class="mt-3">
            <a id="paymentLink" class="btn btn-dark w-100 py-2">
              Proceed to Payment
            </a>
          </div>

        </div>
      </div>

    </div>

    <!-- ================= MAP ================= -->
    <section class="map-section mt-5">
      <h4 class="section-title">Where you'll be</h4>

      <p class="text-muted">
        <i class="fa-solid fa-location-dot"></i>
        <%= listing.location %>, <%= listing.country %>
      </p>

      <div id="map"></div>
    </section>

  </div>

  <script src="https://maps.googleapis.com/maps/api/js?key=<%= process.env.GOOGLE_MAPS_API_KEY %>&callback=initMap"
    async defer></script>