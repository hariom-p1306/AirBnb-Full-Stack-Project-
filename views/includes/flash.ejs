<% if (success && success.length) { %>
  <div id="flash-success" class="custom-flash flash-success" role="alert">
    <div class="flash-icon">
      <i class="fa-solid fa-check"></i>
    </div>

    <div class="flash-message">
      <%= success %>
    </div>

    <button type="button" class="flash-close" onclick="closeFlash('flash-success')">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>
<% } %>

<% if (error && error.length) { %>
  <div id="flash-error" class="custom-flash flash-error" role="alert">
    <div class="flash-icon">
      <i class="fa-solid fa-triangle-exclamation"></i>
    </div>

    <div class="flash-message">
      <%= error %>
    </div>

    <button type="button" class="flash-close" onclick="closeFlash('flash-error')">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>
<% } %>

<script>
  function closeFlash(id) {
    const flash = document.getElementById(id);

    if (flash) {
      flash.classList.add("flash-hide");

      setTimeout(() => {
        flash.remove();
      }, 300);
    }
  }

  setTimeout(() => {
    closeFlash("flash-success");
    closeFlash("flash-error");
  }, 3000);
</script>